# XML-Parser, target native: in the native perl, which runs intltool in the builds (the configure
# of lfs/intltool checks it), against the expat of the global toolchain (MakeMaker links it with
# LD_RUN_PATH on its directory)
PKG_CHECK="${GLOBAL_TOOLCHAIN_PATH}/perl5/bin/perl -MXML::Parser -e 'exit(\$XML::Parser::VERSION eq \"${PKG_VER}\" ? 0 : 1)'"
CONF_FLAGS="EXPATLIBPATH=${GLOBAL_TOOLCHAIN_PATH}/lib EXPATINCPATH=${GLOBAL_TOOLCHAIN_PATH}/include"
