# XML-Parser
PKG_VER=2.59
PKG_URL="https://cpan.metacpan.org/authors/id/T/TO/TODDR/XML-Parser-${PKG_VER}.tar.gz"
### XML::Parser for the perl of the image (intltool): its Makefile.PL run by the native perl with the
### Config of the image (perlmodule), against the expat of the sysroot. The Makefile.PL needs
### File::ShareDir::Install, not a core module, in the perl that runs it; XML::Parser finds its
### encodings with File::ShareDir in the image
PKG_DEPS="lfs/perl5 lfs/perl5:native perl/File-ShareDir-Install:native perl/File-ShareDir lfs/expat"
BUILD_PROCESS=perlmodule
