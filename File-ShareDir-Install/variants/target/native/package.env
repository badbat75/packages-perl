# File-ShareDir-Install, target native: in the native perl, which runs the Makefile.PL of the modules
# that install a share directory (perl/XML-Parser)
PKG_CHECK="${GLOBAL_TOOLCHAIN_PATH}/perl5/bin/perl -MFile::ShareDir::Install -e 'exit(\$File::ShareDir::Install::VERSION eq \"${PKG_VER}\" ? 0 : 1)'"
